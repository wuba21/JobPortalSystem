<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #f0f4f8;" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jobportal.controller.DashboardController">

    <left>
        <VBox prefWidth="250" spacing="10" style="-fx-background-color: linear-gradient(to bottom, #1a237e, #283593); -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 2, 0);">
            <padding>
                <Insets bottom="20" left="15" right="15" top="30" />
            </padding>
            <VBox alignment="CENTER" spacing="10" style="-fx-padding: 0 0 20 0; -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 0 0 1 0;">
                <Label style="-fx-font-size: 22px; -fx-font-weight: 900; -fx-text-fill: white; -fx-letter-spacing: 2px;" text="JOB PORTAL" />
                <Label fx:id="userTypeLabel" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: #e8eaf6; -fx-padding: 4 12; -fx-background-radius: 20; -fx-font-size: 11px; -fx-font-weight: bold;" text="Role" />
            </VBox>

            <VBox spacing="10" style="-fx-padding: 20 0 0 0;" VBox.vgrow="ALWAYS">
                <Label style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0 0 10 5;" text="MAIN MENU" />
                
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#handleViewJobs" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-cursor: hand;" text=" Browse Jobs" />
                
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#handleViewApplications" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-cursor: hand;" text=" My Applications" />

                <!-- Employer Actions Container -->
                <VBox fx:id="employerActions" spacing="10">
                    <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#handlePostJob" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: #69f0ae; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-cursor: hand; -fx-background-radius: 8;" text=" Post a New Job" />
                </VBox>
                
                <!-- Admin Actions Container -->
                <VBox fx:id="adminActions" spacing="10">
                    <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#handleAdminDashboard" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: #e879f9; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-cursor: hand; -fx-background-radius: 8;" text=" Admin Dashboard" />
                </VBox>
                
            </VBox>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox alignment="TOP_LEFT" spacing="20" style="-fx-padding: 25 35;">
                
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Label style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #1a237e;" text="Dashboard Overview" />
                        <Label fx:id="welcomeLabel" style="-fx-font-size: 14px; -fx-text-fill: #546e7a;" text="Welcome back, User!" />
                    </VBox>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <VBox onMouseClicked="#handleStat1Click" spacing="8" style="-fx-cursor: hand; -fx-background-color: white; -fx-padding: 20 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 15, 0, 0, 5); -fx-border-width: 0 0 0 4; -fx-border-color: #3b82f6; -fx-border-radius: 10;" styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold; -fx-font-size: 12px;" text="Job Metrics" />
                        <Label fx:id="statsLabel1" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #0f172a;" text="Total Users:" />
                    </VBox>
                    <VBox onMouseClicked="#handleStat2Click" spacing="8" style="-fx-cursor: hand; -fx-background-color: white; -fx-padding: 20 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 15, 0, 0, 5); -fx-border-width: 0 0 0 4; -fx-border-color: #10b981; -fx-border-radius: 10;" styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold; -fx-font-size: 12px;" text="Application Volume" />
                        <Label fx:id="statsLabel2" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #0f172a;" text="Total Jobs:" />
                    </VBox>
                    <VBox onMouseClicked="#handleStat3Click" spacing="8" style="-fx-cursor: hand; -fx-background-color: white; -fx-padding: 20 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 15, 0, 0, 5); -fx-border-width: 0 0 0 4; -fx-border-color: #f59e0b; -fx-border-radius: 10;" styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold; -fx-font-size: 12px;" text="Platform Insight" />
                        <Label fx:id="statsLabel3" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #0f172a;" text="Total Applicant:" />
                    </VBox>

                </HBox>
                <VBox spacing="10" style="-fx-background-color: linear-gradient(to right, #4facfe, #00f2fe); -fx-padding: 25 30; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,242,254,0.3), 10, 0, 0, 3);">
                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" text="Take The Next Leap in Your Career" />
                    <Label style="-fx-text-fill: white; -fx-font-size: 14px; -fx-opacity: 0.9;" text="Explore the newest highly-paid positions published today or track your existing applications effortlessly from your secure panel." wrapText="true" />
                </VBox>

                <!-- Recommendation System UI -->
                <VBox fx:id="recommendedSection" managed="false" spacing="15" visible="false">
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="🔥 Recommended Jobs For You" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="Based on your recent applications and profile." />
                    <VBox fx:id="recommendedJobsContainer" spacing="10" />
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
