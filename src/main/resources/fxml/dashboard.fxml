<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<BorderPane style="-fx-background-color: #f0f4f8;" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jobportal.controller.DashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: linear-gradient(to right, #1a237e, #283593); -fx-padding: 15 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 3);">
            <!-- Branding / role badge -->
            <HBox alignment="CENTER" spacing="10">
                <Label style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: white; -fx-letter-spacing: 1px;" text="PORTAL" />
                <Label fx:id="userTypeLabel" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: #e8eaf6; -fx-padding: 4 12; -fx-background-radius: 20; -fx-font-size: 11px; -fx-font-weight: bold;" text="Role" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Horizontal navigation buttons -->
            <HBox alignment="CENTER" spacing="15">
                <Button onAction="#handleViewJobs"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"
                        text="🔍 Browse Jobs" />

                <Button onAction="#handleCVBuilder"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"
                        text="📋 CV Builder" />

                <!-- ── Employer-only actions ── -->
                <HBox fx:id="employerActions" spacing="15" alignment="CENTER" visible="false" managed="false">
                    <Button onAction="#handleManageJobs"
                            style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"
                            text="📝 Manage Jobs" />

                    <Button onAction="#handlePostJob"
                            style="-fx-background-color: #69f0ae; -fx-text-fill: #1a237e; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 20; -fx-padding: 6 15;"
                            text="➕ Post Job" />

                    <Button onAction="#handleViewApplications"
                            style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"
                            text="👥 View Applications" />
                </HBox>

                <!-- ── Admin-only actions ── -->
                <HBox fx:id="adminActions" spacing="15" alignment="CENTER" visible="false" managed="false">
                    <Button onAction="#handleAdminDashboard"
                            style="-fx-background-color: #e879f9; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 20; -fx-padding: 6 15;"
                            text="🛡 Admin Panel" />
                </HBox>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox alignment="TOP_LEFT" spacing="20" style="-fx-padding: 25 35;">

                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Label style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #1a237e;" text="Dashboard Overview" />
                        <Label fx:id="welcomeLabel" style="-fx-font-size: 14px; -fx-text-fill: #546e7a;" text="Welcome back, User!" />
                    </VBox>
                </HBox>

                <!-- Stats row -->
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <VBox onMouseClicked="#handleStat1Click" spacing="8"
                          style="-fx-cursor: hand; -fx-background-color: white; -fx-padding: 20 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 15, 0, 0, 5); -fx-border-width: 0 0 0 4; -fx-border-color: #3b82f6; -fx-border-radius: 10;"
                          styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold; -fx-font-size: 12px;" text="Job Metrics" />
                        <Label fx:id="statsLabel1" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #0f172a;" text="Total Users:" />
                    </VBox>
                    <VBox onMouseClicked="#handleStat2Click" spacing="8"
                          style="-fx-cursor: hand; -fx-background-color: white; -fx-padding: 20 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 15, 0, 0, 5); -fx-border-width: 0 0 0 4; -fx-border-color: #10b981; -fx-border-radius: 10;"
                          styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold; -fx-font-size: 12px;" text="Application Volume" />
                        <Label fx:id="statsLabel2" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #0f172a;" text="Total Jobs:" />
                    </VBox>
                    <VBox onMouseClicked="#handleStat3Click" spacing="8"
                          style="-fx-cursor: hand; -fx-background-color: white; -fx-padding: 20 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 15, 0, 0, 5); -fx-border-width: 0 0 0 4; -fx-border-color: #f59e0b; -fx-border-radius: 10;"
                          styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold; -fx-font-size: 12px;" text="Platform Insight" />
                        <Label fx:id="statsLabel3" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #0f172a;" text="Total Applicant:" />
                    </VBox>
                </HBox>

                <!-- Hero banner -->
                <VBox spacing="10" style="-fx-background-color: linear-gradient(to right, #4facfe, #00f2fe); -fx-padding: 25 30; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,242,254,0.3), 10, 0, 0, 3);">
                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" text="Take The Next Leap in Your Career" />
                    <Label style="-fx-text-fill: white; -fx-font-size: 14px; -fx-opacity: 0.9;" text="Explore the newest highly-paid positions published today or track your existing applications effortlessly from your secure panel." wrapText="true" />
                </VBox>

                <!-- Recommendation section -->
                <VBox fx:id="recommendedSection" managed="false" spacing="15" visible="false">
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="🔥 Recommended Jobs For You" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="Based on your recent applications and profile." />
                    <VBox fx:id="recommendedJobsContainer" spacing="10" />
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
