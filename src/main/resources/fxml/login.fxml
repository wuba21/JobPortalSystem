<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<StackPane stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jobportal.controller.LoginController" styleClass="root-pane">
    <VBox alignment="CENTER" spacing="20" maxWidth="450" maxHeight="500" styleClass="card" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 5);">
        
        <Label text="Online Job Portal" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1a237e; -fx-font-family: 'Segoe UI';"/>
        <Label text="Sign in to your account" style="-fx-font-size: 16px; -fx-text-fill: #666; -fx-margin-bottom: 20;"/>

        <VBox spacing="10" alignment="CENTER_LEFT" maxWidth="Infinity">
            <Label text="Email Address" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
            <TextField fx:id="emailField" promptText="Enter your email address" styleClass="text-field-custom" style="-fx-pref-height: 40px;"/>
        </VBox>

        <VBox spacing="10" alignment="CENTER_LEFT" maxWidth="Infinity">
            <Label text="Password" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
            <StackPane alignment="CENTER_RIGHT">
                <TextField fx:id="passwordTextField" promptText="Enter your password" visible="false" managed="false" styleClass="text-field-custom" style="-fx-pref-height: 40px;"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="text-field-custom" style="-fx-pref-height: 40px;"/>
                <ToggleButton fx:id="showPasswordBtn" text="👁" onAction="#togglePasswordVisibility" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #666; -fx-font-size: 14px; -fx-padding: 0 10 0 0;" />
            </StackPane>
        </VBox>

        <HBox alignment="CENTER_RIGHT" maxWidth="Infinity" style="-fx-margin-top: -10;">
            <Hyperlink text="Forgot Password?" onAction="#handleForgotPassword" style="-fx-font-size: 13px; -fx-text-fill: #3f51b5;"/>
        </HBox>

        <StackPane maxWidth="Infinity">
            <Button fx:id="loginButton" text="Login" onAction="#handleLogin" styleClass="btn-primary" style="-fx-pref-height: 45px; -fx-font-size: 16px;" maxWidth="Infinity"/>
            <ProgressIndicator fx:id="loginProgress" visible="false" style="-fx-max-width: 25; -fx-max-height: 25;"/>
        </StackPane>

        <HBox alignment="CENTER" spacing="8" style="-fx-padding: 10 0 0 0;">
            <Label text="Don't have an account?" style="-fx-font-size: 14px; -fx-text-fill: #555;"/>
            <Hyperlink text="Register Now" onAction="#handleRegister" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3f51b5;"/>
        </HBox>

        <Button text="Back to Home" onAction="#handleBackToHome" style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 14px;"/>

    </VBox>
</StackPane>
