<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ProgressIndicator?>

<BorderPane stylesheets="@../css/style.css" styleClass="root-pane" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jobportal.controller.JobController">
    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #1e3c72, #2a5298); -fx-padding: 30 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 5);" spacing="20">
            <HBox alignment="CENTER_LEFT">
                <Label text="Discover Your Dream Job" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 3, 0, 0, 2);"/>
                <Region HBox.hgrow="ALWAYS" />
            </HBox>
            
            <!-- Basic Search Controls -->
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: white; -fx-padding: 10 15; -fx-background-radius: 50; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 4);">
                <TextField fx:id="keywordField" promptText="Job Title or Keyword..." style="-fx-background-color: transparent; -fx-font-size: 15px;" HBox.hgrow="ALWAYS" />
                <Separator orientation="VERTICAL" />
                <ComboBox fx:id="jobTypeCombo" prefWidth="140" style="-fx-background-color: transparent; -fx-font-size: 15px;" />
                <ToggleButton fx:id="advancedSearchBtn" text="🔍 Filters" style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 15; -fx-background-radius: 25; -fx-cursor: hand;" />
            </HBox>
            
            <!-- Advanced Search Controls (Hidden by default) -->
            <HBox fx:id="advancedSearchBox" visible="false" managed="false" alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                <Label text="Location:" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                <TextField fx:id="locationField" promptText="City, Country..." style="-fx-min-width: 150; -fx-font-size: 14px;" />
                
                <Label text="Salary Range:" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 0 0 0 15;" />
                <TextField fx:id="minSalaryField" promptText="Min" style="-fx-max-width: 100; -fx-font-size: 14px;" />
                <Label text="-" style="-fx-font-size: 14px;" />
                <TextField fx:id="maxSalaryField" promptText="Max" style="-fx-max-width: 100; -fx-font-size: 14px;" />
                
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleAdvancedSearch" style="-fx-background-color: #00e676; -fx-text-fill: #1a237e; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 25; -fx-background-radius: 25; -fx-cursor: hand;" text="🔎 Search" />
                <Button onAction="#handleResetFilters" style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 25; -fx-cursor: hand;" text="Reset" />
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="15" VBox.vgrow="ALWAYS" style="-fx-padding: 20 20 20 20;">
            <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2); -fx-padding: 10;" VBox.vgrow="ALWAYS">
                <StackPane VBox.vgrow="ALWAYS">
                    <TableView fx:id="jobTable" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="titleColumn" prefWidth="200" text="Position" />
                            <TableColumn fx:id="companyColumn" prefWidth="150" text="Company" />
                            <TableColumn fx:id="locationColumn" prefWidth="130" text="Location" />
                            <TableColumn fx:id="typeColumn" prefWidth="100" text="Type" />
                            <TableColumn fx:id="salaryColumn" prefWidth="120" text="Salary" />
                            <TableColumn fx:id="actionColumn" prefWidth="120" text="Action" />
                        </columns>
                    </TableView>
                    <ProgressIndicator fx:id="loadingSpinner" visible="false" style="-fx-max-width: 50; -fx-max-height: 50;"/>
                </StackPane>
                <HBox alignment="CENTER_RIGHT" style="-fx-padding: 15 10 5 0;">
                    <Button onAction="#handleBackToDashboard" style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-font-size: 15px; -fx-padding: 10 25; -fx-background-radius: 30; -fx-cursor: hand;" text="Back to Dashboard" />
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
