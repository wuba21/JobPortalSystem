<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jobportal.controller.AdminMessagesController">
    <!-- LEFT SIDEBAR -->
    <left>
        <VBox spacing="10.0" style="-fx-background-color: #1e293b; -fx-padding: 20;" prefWidth="250.0">
            <Label text="Admin Panel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <VBox spacing="15.0" VBox.vgrow="ALWAYS" style="-fx-padding: 30 0 0 0;">
                <Button maxWidth="1.7976931348623157E308" text="Messages" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
                <Button onAction="#handleManageJobs" maxWidth="1.7976931348623157E308" text="Manage Jobs" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-size: 16px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
                <Button onAction="#handleBack" maxWidth="1.7976931348623157E308" text="Back to Dashboard" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-size: 16px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
            </VBox>
        </VBox>
    </left>

    <!-- CENTER CONTENT -->
    <center>
        <VBox spacing="15.0" style="-fx-padding: 20;">
            <Label text="Contact Messages" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
            
            <TableView fx:id="messagesTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                <columns>
                    <TableColumn fx:id="colName" text="Name" prefWidth="150.0" />
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="200.0" />
                    <TableColumn fx:id="colSubject" text="Subject" prefWidth="150.0" />
                    <TableColumn fx:id="colDate" text="Date" prefWidth="120.0" />
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="80.0" />
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="200.0" style="-fx-alignment: CENTER;" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
