<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="root-pane" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jobportal.controller.ForgotPasswordController">
    <VBox alignment="CENTER" maxHeight="600" maxWidth="450" spacing="20" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 5);" styleClass="card">
        
        <Label style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1a237e; -fx-font-family: 'Segoe UI';" text="Reset Password" underline="true" />
        <Label style="-fx-font-size: 16px; -fx-text-fill: #666; -fx-margin-bottom: 10;" text="Enter your email to reset password" />

        <VBox fx:id="step1Box" alignment="CENTER" spacing="15" maxWidth="Infinity">
            <VBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="10">
                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Email Address" />
                <TextField fx:id="emailField" promptText="Enter your email address" style="-fx-pref-height: 40px;" styleClass="text-field-custom" />
            </VBox>
            <VBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="10">
                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Phone Number" />
                <TextField fx:id="phoneField" promptText="Enter your registered phone number" style="-fx-pref-height: 40px;" styleClass="text-field-custom" />
            </VBox>
            <StackPane maxWidth="Infinity" style="-fx-margin-top: 10;">
                <Button fx:id="sendOtpButton" maxWidth="Infinity" onAction="#handleSendOtp" style="-fx-pref-height: 45px; -fx-font-size: 16px;" styleClass="btn-primary" text="Send OTP to Email" />
                <ProgressIndicator fx:id="otpProgress" style="-fx-max-width: 25; -fx-max-height: 25;" visible="false" />
            </StackPane>
        </VBox>

        <VBox fx:id="step2Box" alignment="CENTER" spacing="15" maxWidth="Infinity" visible="false" managed="false">
            <VBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="10">
                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Paste Google App Password" />
                <TextField fx:id="otpField" promptText="Enter the 16-character code from Google" style="-fx-pref-height: 40px;" styleClass="text-field-custom" />
            </VBox>

            <VBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="10">
                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" text="New Password" />
                <StackPane alignment="CENTER_RIGHT">
                    <TextField fx:id="newPasswordTextField" managed="false" promptText="Enter new password" style="-fx-pref-height: 40px;" styleClass="text-field-custom" visible="false" />
                    <PasswordField fx:id="newPasswordField" promptText="Enter new password" style="-fx-pref-height: 40px;" styleClass="text-field-custom" />
                    <ToggleButton fx:id="showNewPasswordBtn" onAction="#toggleNewPasswordVisibility" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #666; -fx-font-size: 14px; -fx-padding: 0 10 0 0;" text="👁" />
                </StackPane>
            </VBox>

            <VBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="10">
                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Confirm New Password" />
                <StackPane alignment="CENTER_RIGHT">
                    <TextField fx:id="confirmPasswordTextField" managed="false" promptText="Confirm new password" style="-fx-pref-height: 40px;" styleClass="text-field-custom" visible="false" />
                    <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password" style="-fx-pref-height: 40px;" styleClass="text-field-custom" />
                    <ToggleButton fx:id="showConfirmPasswordBtn" onAction="#toggleConfirmPasswordVisibility" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #666; -fx-font-size: 14px; -fx-padding: 0 10 0 0;" text="👁" />
                </StackPane>
            </VBox>

            <StackPane maxWidth="Infinity" style="-fx-margin-top: 10;">
                <Button fx:id="resetButton" maxWidth="Infinity" onAction="#handleResetPassword" style="-fx-pref-height: 45px; -fx-font-size: 16px;" styleClass="btn-primary" text="Reset Password" />
                <ProgressIndicator fx:id="resetProgress" style="-fx-max-width: 25; -fx-max-height: 25;" visible="false" />
            </StackPane>
        </VBox>

        <HBox alignment="CENTER" spacing="8" style="-fx-padding: 10 0 0 0;">
            <Label style="-fx-font-size: 14px; -fx-text-fill: #555;" text="Remembered your password?" />
            <Hyperlink onAction="#handleBackToLogin" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3f51b5;" text="Back to Login" />
        </HBox>

    </VBox>
</StackPane>
