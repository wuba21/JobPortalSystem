<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane fx:id="mainBorderPane" prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jobportal.controller.MainLayoutController">
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="20.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                <padding>
                    <Insets bottom="10.0" left="40.0" right="40.0" top="10.0" />
                </padding>
                
                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-cursor: hand;">
                    <ImageView fitHeight="35.0" fitWidth="35.0" preserveRatio="true">
                        <image>
                            <Image url="@../images/logo.jpg" />
                        </image>
                    </ImageView>
                    <Label style="-fx-font-weight: bold; -fx-font-size: 24px; -fx-text-fill: #0ea5e9;" text="JobPortal" />
                </HBox>
                
                <Region HBox.hgrow="ALWAYS" />
                
                <HBox alignment="CENTER" spacing="25.0">
                    <Button styleClass="nav-btn" text="Home" onAction="#handleNavHome" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                    <Button styleClass="nav-btn" text="Jobs" onAction="#handleNavJobs" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                    <Button styleClass="nav-btn" text="Companies" onAction="#handleNavCompanies" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                    <Button styleClass="nav-btn" text="About" onAction="#handleNavAbout" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                    <Button styleClass="nav-btn" text="Contact" onAction="#handleNavContact" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                </HBox>
                
                <Region HBox.hgrow="ALWAYS" />
                
                <HBox alignment="CENTER" spacing="15.0">
                    <Button fx:id="btnSignIn" mnemonicParsing="false" onAction="#handleSignIn" style="-fx-background-color: transparent; -fx-text-fill: #0ea5e9; -fx-font-weight: bold; -fx-cursor: hand;" text="Sign In" />
                    
                    <MenuButton fx:id="profileMenu" visible="false" managed="false" style="-fx-background-color: transparent; -fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 14px; -fx-border-color: #cbd5e1; -fx-border-radius: 20; -fx-padding: 2 10;">
                        <items>
                            <MenuItem text="My Profile" onAction="#handleViewProfile" />
                            <MenuItem text="📋 CV Builder" onAction="#handleCVBuilder" />
                            <MenuItem text="Saved Jobs" onAction="#handleSavedJobs" />
                            <MenuItem text="Notifications" onAction="#handleNotifications" />
                            <MenuItem text="Logout" onAction="#handleLogout" />
                        </items>
                    </MenuButton>
                </HBox>
            </HBox>
        </VBox>
    </top>
</BorderPane>
