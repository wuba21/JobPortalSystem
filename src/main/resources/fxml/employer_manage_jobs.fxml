<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<VBox spacing="20" style="-fx-padding: 30;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jobportal.controller.EmployerManageJobsController">
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Manage Jobs" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        <ProgressIndicator fx:id="loadingSpinner" visible="false" managed="true" prefWidth="25" prefHeight="25"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button mnemonicParsing="false" onAction="#handleBackToDashboard" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Back to Dashboard" />
    </HBox>

    <StackPane VBox.vgrow="ALWAYS">
        <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2); -fx-padding: 10;">
            <TableView fx:id="jobsTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 14px;">
                <columns>
                    <TableColumn fx:id="titleColumn" prefWidth="300" text="Job Title" />
                    <TableColumn fx:id="locationColumn" prefWidth="150" text="Location" />
                    <TableColumn fx:id="deadlineColumn" prefWidth="120" text="Deadline" />
                    <TableColumn fx:id="actionColumn" prefWidth="180" text="Actions" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </StackPane>
</VBox>
