<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.control.ProgressIndicator?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #f8fafc; -fx-border-color: transparent;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jobportal.controller.CompanyDetailsController">
    <VBox spacing="20.0">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="30.0" />
        </padding>
        
        <Button mnemonicParsing="false" onAction="#handleBack" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-padding: 8 15; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);" text="← Back to Companies" />
        
        <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <VBox fx:id="logoBox" alignment="CENTER" prefHeight="80.0" prefWidth="80.0" style="-fx-background-color: #e0f2fe; -fx-background-radius: 40;">
                    <Label fx:id="lblCompanyInitial" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #0ea5e9;" text="A" />
                </VBox>
                <VBox spacing="5.0">
                    <Label fx:id="lblCompanyName" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Company Name" />
                    <Label fx:id="lblJobCount" style="-fx-text-fill: #059669; -fx-font-size: 14px; -fx-font-weight: bold;" text="0 Open Jobs" />
                </VBox>
            </HBox>
            
            <Region prefHeight="10.0" />
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="About Company" />
            
            <Label fx:id="lblDescription" style="-fx-text-fill: #475569; -fx-font-size: 15px; -fx-line-spacing: 5px;" text="Company description goes here" wrapText="true" />
        </VBox>
        
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-padding: 20 0 0 0;" text="Available Jobs" />
        
        <VBox alignment="TOP_CENTER" spacing="20">
            <ProgressIndicator fx:id="loadingSpinner" visible="false" />
            <FlowPane fx:id="jobsContainer" hgap="20" vgap="20" alignment="TOP_LEFT" />
        </VBox>
        
    </VBox>
</ScrollPane>
