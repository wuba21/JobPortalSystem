<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jobportal.controller.NotificationsController">
    <VBox spacing="20.0">
        <padding>
            <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
        </padding>
        <HBox alignment="CENTER_LEFT">
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Notifications" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="markAllReadBtn" text="Mark All Read" onAction="#handleMarkAllRead" style="-fx-background-color: #e2e8f0; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;" />
        </HBox>
        <Label fx:id="emptyLabel" style="-fx-text-fill: #64748b; -fx-font-size: 16px;" text="You have no notifications." visible="false" managed="false"/>
        <VBox fx:id="notificationsContainer" spacing="10.0" />
    </VBox>
</ScrollPane>
