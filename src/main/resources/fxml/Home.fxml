<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<BorderPane stylesheets="@../css/style.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="com.jobportal.controller.HomeController" style="-fx-background-image: url('/images/jobbg.jpg'); -fx-background-size: cover; -fx-background-position: center center;">
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox>
                <VBox alignment="CENTER" spacing="40" style="-fx-background-color: rgba(0, 0, 0, 0.45); -fx-padding: 80 50 80 50;">
                    <VBox alignment="CENTER" spacing="15">
                        <Label style="-fx-font-size:48px; -fx-font-weight:900; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 10, 0, 0, 5);" text="Find Your Dream Job Today" />
                        <Label maxWidth="600" style="-fx-font-size:18px; -fx-text-fill: white; -fx-font-weight: bold; -fx-alignment:center; -fx-text-alignment:center; -fx-line-spacing: 5px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 8, 0, 0, 3);" text="Search thousands of jobs, apply easily, and build your career with confidence. Your next big opportunity is just a click away." wrapText="true" />
                    </VBox>

                    <HBox alignment="CENTER" spacing="20">
                        <Button fx:id="browseBtn" onAction="#handleBrowseJobs" style="-fx-background-color: linear-gradient(to right, #3b82f6, #0ea5e9); -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12 40; -fx-background-radius: 30; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(14,165,233,0.5), 15, 0, 0, 5);" text="Browse Jobs Now" />
                    </HBox>

                    <HBox alignment="CENTER" spacing="30">
                        <VBox alignment="CENTER" spacing="15" style="-fx-background-color: rgba(15, 23, 42, 0.85); -fx-padding: 30; -fx-background-radius: 20; -fx-border-color: #3b82f6; -fx-border-width: 2; -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(59,130,246,0.3), 20,0,0,5);">
                            <Label style="-fx-font-weight:bold; -fx-font-size: 18px; -fx-text-fill: white;" text="🔍 Easy Search" />
                            <Label maxWidth="220" minHeight="-Infinity" style="-fx-text-fill: #cbd5e1; -fx-alignment: center; -fx-text-alignment: center;" text="Find jobs quickly with our smart filters and matching algorithm." wrapText="true" />
                        </VBox>

                        <VBox alignment="CENTER" spacing="15" style="-fx-background-color: rgba(15, 23, 42, 0.85); -fx-padding: 30; -fx-background-radius: 20; -fx-border-color: #10b981; -fx-border-width: 2; -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(16,185,129,0.3), 20,0,0,5);">
                            <Label style="-fx-font-weight:bold; -fx-font-size: 18px; -fx-text-fill: white;" text="⚡ Quick Apply" />
                            <Label maxWidth="220" minHeight="-Infinity" style="-fx-text-fill: #cbd5e1; -fx-alignment: center; -fx-text-alignment: center;" text="Apply to top companies in just a few clicks with your saved profile." wrapText="true" />
                        </VBox>

                        <VBox alignment="CENTER" spacing="15" style="-fx-background-color: rgba(15, 23, 42, 0.85); -fx-padding: 30; -fx-background-radius: 20; -fx-border-color: #f59e0b; -fx-border-width: 2; -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(245,158,11,0.3), 20,0,0,5);">
                            <Label style="-fx-font-weight:bold; -fx-font-size: 18px; -fx-text-fill: white;" text="📈 Track Progress" />
                            <Label maxWidth="220" minHeight="-Infinity" style="-fx-text-fill: #cbd5e1; -fx-alignment: center; -fx-text-alignment: center;" text="Manage all your applications and track status updates easily." wrapText="true" />
                        </VBox>
                    </HBox>

                    <Button fx:id="groupBtn" onAction="#handleShowGroup" style="-fx-margin-top: 40px; -fx-padding: 12 40; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-color: rgba(15, 23, 42, 0.7); -fx-border-color: rgba(255,255,255,0.5); -fx-text-fill: white; -fx-border-radius: 30; -fx-background-radius: 30; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10,0,0,3);" text="Group Member" />
                </VBox>
                
                <!-- FOOTER SECTION -->
                <VBox style="-fx-background-color: rgba(0, 0, 0, 0.75); -fx-padding: 60 40 20 40; -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 1 0 0 0;">
                    
                    <!-- 4 Column Layout -->
                    <HBox spacing="40" alignment="TOP_CENTER">
                        
                        <!-- Col 1: About -->
                        <VBox spacing="15" maxWidth="250">
                            <Label text="Jobportalsystem-Jobs" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: 900; -fx-effect: dropshadow(gaussian, rgba(59,130,246,0.8), 10,0,0,2);"/>
                            <Label text="A premier job portal connecting top-tier employers with ambitious job seekers. We make hiring and applying seamless and efficient." wrapText="true" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px; -fx-line-spacing: 4px;"/>
                        </VBox>
                        
                        <VBox spacing="10" prefWidth="150">
                            <Label text="Quick Links" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                            <VBox spacing="8" style="-fx-padding: 10 0 0 0;">
                                <Label text="- Home" style="-fx-text-fill: #94a3b8; -fx-font-size: 14px; -fx-cursor: hand;" onMouseClicked="#handleNavHome" onMouseEntered="#handleFooterHover" onMouseExited="#handleFooterExit"/>
                                <Label text="- Jobs" style="-fx-text-fill: #94a3b8; -fx-font-size: 14px; -fx-cursor: hand;" onMouseClicked="#handleNavJobs" onMouseEntered="#handleFooterHover" onMouseExited="#handleFooterExit"/>
                                <Label text="- About" style="-fx-text-fill: #94a3b8; -fx-font-size: 14px; -fx-cursor: hand;" onMouseClicked="#handleNavAbout" onMouseEntered="#handleFooterHover" onMouseExited="#handleFooterExit"/>
                                <Label text="- Contact" style="-fx-text-fill: #94a3b8; -fx-font-size: 14px; -fx-cursor: hand;" onMouseClicked="#handleNavContact" onMouseEntered="#handleFooterHover" onMouseExited="#handleFooterExit"/>
                            </VBox>
                        </VBox>
                        
                        <VBox spacing="10" prefWidth="200">
                            <Label text="Contact Us" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                            <VBox spacing="10" style="-fx-padding: 10 0 0 0;">
                                <Label text="📧 admin@jobportal.com" style="-fx-text-fill: #94a3b8; -fx-font-size: 14px;"/>
                                <Label text="📞 +251987654321" style="-fx-text-fill: #94a3b8; -fx-font-size: 14px;"/>
                                <Label text="📍 UOG, Ethiopia, informatics, comsce Lab 301 " wrapText="true" style="-fx-text-fill: #94a3b8; -fx-font-size: 14px;"/>
                            </VBox>
                        </VBox>

                    </HBox>
                    <javafx.scene.shape.Line endX="1000" stroke="#1e293b" style="-fx-opacity: 0.5; -fx-margin: 30 0 20 0;" />
                    
                    <HBox alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                        <Label text="© 2026 Jobportalsystem-Jobs. All rights reserved." style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
