<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jobportal.controller.AdminDashboardController">
    <!-- TOP HEADER & NAVBAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #1e293b; -fx-padding: 15 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
            <Label text="Admin Panel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" />
            
            <Region HBox.hgrow="ALWAYS" />
            
            <HBox alignment="CENTER" spacing="20.0">
                <Button text="Messages" onAction="#showMessages" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" />
                <Button text="Manage Jobs" onAction="#showManageJobs" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" />
                <Button text="Reports" onAction="#showReports" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" />
                <Button onAction="#handleBack" text="Back to Dashboard" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5; -fx-padding: 6 15;" />
            </HBox>
            
            <Region prefWidth="15.0" />
            
            <HBox alignment="CENTER" spacing="10.0" style="-fx-cursor: hand;" onMouseClicked="#showMessages">
                <StackPane>
                    <Label text="🔔" style="-fx-font-size: 20px;" />
                    <Label fx:id="notificationBadge" text="0" visible="false" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 2 6; -fx-background-radius: 10; -fx-translate-x: 10; -fx-translate-y: -10;" />
                </StackPane>
                <Label fx:id="notificationText" text="No New Messages" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" />
            </HBox>
        </HBox>
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <StackPane style="-fx-padding: 15;">
            
            <!-- MANAGE JOBS VIEW -->
            <VBox fx:id="jobsView" spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" visible="false">
                <Label text="Manage Jobs" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                <TableView fx:id="jobsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colJobTitle" text="Job Title" prefWidth="300.0" />
                        <TableColumn fx:id="colJobCompany" text="Company" prefWidth="150.0" />
                        <TableColumn fx:id="colJobLocation" text="Location" prefWidth="150.0" />
                        <TableColumn fx:id="colJobActions" text="Actions" prefWidth="150.0" minWidth="150.0" maxWidth="150.0" style="-fx-alignment: CENTER;" />
                    </columns>
                </TableView>
            </VBox>

            <!-- REPORTS VIEW -->
            <VBox fx:id="reportsView" spacing="20.0" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" visible="false">
                <Label text="Generate Reports" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                <Label text="Select a report type to export data as PDF or Excel." style="-fx-text-fill: #64748b; -fx-font-size: 14px;" />
                
                <HBox spacing="20.0" alignment="CENTER_LEFT">
                    <VBox spacing="10.0" style="-fx-padding: 20; -fx-border-color: #cbd5e1; -fx-border-radius: 8;">
                        <Label text="Users Report" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                        <HBox spacing="10.0">
                            <Button text="Export PDF" onAction="#handleExportUsersPDF" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                            <Button text="Export Excel" onAction="#handleExportUsersExcel" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                        </HBox>
                    </VBox>
                    
                    <VBox spacing="10.0" style="-fx-padding: 20; -fx-border-color: #cbd5e1; -fx-border-radius: 8;">
                        <Label text="Jobs Report" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                        <HBox spacing="10.0">
                            <Button text="Export PDF" onAction="#handleExportJobsPDF" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                            <Button text="Export Excel" onAction="#handleExportJobsExcel" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                        </HBox>
                    </VBox>
                    
                    <VBox spacing="10.0" style="-fx-padding: 20; -fx-border-color: #cbd5e1; -fx-border-radius: 8;">
                        <Label text="Applications Report" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                        <HBox spacing="10.0">
                            <Button text="Export PDF" onAction="#handleExportAppsPDF" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                            <Button text="Export Excel" onAction="#handleExportAppsExcel" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>



        </StackPane>
    </center>
</BorderPane>
