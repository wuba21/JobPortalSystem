<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jobportal.controller.ProfileController">
    <VBox alignment="CENTER" spacing="20.0">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="30.0" />
        </padding>
        <VBox maxWidth="600.0" spacing="20.0" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="My Profile" />
            
            <VBox spacing="5.0">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Full Name *" />
                <TextField fx:id="fullNameField" style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #cbd5e1; -fx-border-radius: 5;" />
            </VBox>
            
            <VBox spacing="5.0">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Email Address (Read-only)" />
                <TextField fx:id="emailField" editable="false" style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #cbd5e1; -fx-border-radius: 5; -fx-background-color: #f1f5f9;" />
            </VBox>
            
            <VBox spacing="5.0">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Phone Number" />
                <TextField fx:id="phoneField" promptText="Enter your phone number" style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #cbd5e1; -fx-border-radius: 5;" />
            </VBox>
            
            <VBox spacing="5.0">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Gender" />
                <ComboBox fx:id="genderCombo" maxWidth="1.7976931348623157E308" style="-fx-padding: 5; -fx-background-radius: 5; -fx-border-color: #cbd5e1; -fx-border-radius: 5;" />
            </VBox>
            
            <VBox spacing="5.0">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Address" />
                <TextArea fx:id="addressField" prefRowCount="3" style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #cbd5e1; -fx-border-radius: 5;" />
            </VBox>
            
            <Label fx:id="statusLabel" visible="false" />

            <Button fx:id="saveButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleSaveProfile" style="-fx-background-color: #0ea5e9; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 12; -fx-background-radius: 5; -fx-cursor: hand;" text="Save Changes" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleBack" style="-fx-background-color: transparent; -fx-border-color: #cbd5e1; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10; -fx-border-radius: 5; -fx-cursor: hand;" text="Cancel" />
        </VBox>
    </VBox>
</ScrollPane>
