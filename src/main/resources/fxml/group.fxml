<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="600.0" style="-fx-background-color: #f8fafc;" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jobportal.controller.GroupController">
    
    <center>
        <VBox alignment="CENTER" prefHeight="566.0" prefWidth="582.0" spacing="15" style="-fx-padding: 20;">
            <!-- TOP SECTION: HEADER && IMAGE -->
            <ImageView fx:id="logoImageView" fitHeight="79.0" fitWidth="120" preserveRatio="true" smooth="true" />

            <VBox alignment="CENTER" spacing="5">
                <Label prefHeight="28.0" prefWidth="279.0" style="-fx-font-weight: bold; -fx-font-size: 22px; -fx-text-fill: #1e3a8a; -fx-font-family: 'Segoe UI', Arial, sans-serif;" text="UNIVERSITY OF GONDAR" />
                <Label style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #1e3a8a; -fx-font-family: 'Segoe UI', Arial, sans-serif;" text="INFORMATICS COLLEGE" />
                <Label style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1e3a8a; -fx-font-family: 'Segoe UI', Arial, sans-serif;" text="DEPARTMENT OF COMPUTER SCIENCE" />
                <Label style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #0f172a; -fx-padding: 10 0 0 0; -fx-font-family: 'Segoe UI', Arial, sans-serif;" text="PROJECT TITLE: ONLINE JOB PORTAL SYSTEM" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #475569; -fx-font-family: 'Segoe UI', Arial, sans-serif;" text="ACADEMIC YEAR: 2026" />
            </VBox>

            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #000000; -fx-underline: true; -fx-padding: 10 0 0 0;" text="Group Members" />

           
            <GridPane fx:id="membersGrid" alignment="CENTER" hgap="20" vgap="10">
              
            </GridPane>

        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" style="-fx-padding: 10;">
            <Button onAction="#handleClose" prefHeight="47.0" prefWidth="112.0" style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-font-size: 10px; -fx-padding: 8 40; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-color: #cbd5e1; -fx-border-radius: 6;" text="Close" />
        </HBox>
    </bottom>

</BorderPane>
