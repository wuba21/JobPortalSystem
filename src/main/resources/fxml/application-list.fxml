<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root-pane" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jobportal.controller.ApplicationController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-bar">
            <padding><Insets bottom="10" left="20" right="20" top="10" /></padding>
            <Label styleClass="page-title" text="Applications" />
        </HBox>
    </top>

    <center>
        <VBox spacing="15" VBox.vgrow="ALWAYS" style="-fx-padding: 20 20 20 20;">
            <!-- Modern Styled Application Table -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2); -fx-padding: 10;" VBox.vgrow="ALWAYS">
                <TableView fx:id="applicationTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                   
                    <columns>
                        <TableColumn fx:id="jobTitleColumn" prefWidth="200" text="Job Title" />
                        <TableColumn fx:id="applicantColumn" prefWidth="150" text="Applicant" />
                        <TableColumn fx:id="statusColumn" prefWidth="120" text="Status" />
                        <TableColumn fx:id="dateColumn" prefWidth="150" text="Date Applied" />
                        <TableColumn fx:id="actionColumn" prefWidth="250" text="Action" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-padding: 15 10 5 0;">
                    <Button onAction="#handleExportCSV" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-padding: 10 25; -fx-background-radius: 30; -fx-cursor: hand;" text="Export CSV" />
                    <Button onAction="#handleBackToDashboard" style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-font-size: 15px; -fx-padding: 10 25; -fx-background-radius: 30; -fx-cursor: hand;" text="Back to Dashboard" />
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
